{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gebatrh-production.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://gebatrh-production.up.railway.app/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://gebatrh-production.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    }
  ]
}
